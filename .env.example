# Arquivo de exemplo. Nunca cole uma chave privada no chat nem versione .env.local.
# O portal usa Supabase; as variáveis Firebase abaixo são mantidas para o adaptador legado.
APP_MODE=supabase
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_DATABASE_URL=
# JSON da conta de serviço SOMENTE no servidor; ou GOOGLE_APPLICATION_CREDENTIALS local.
FIREBASE_SERVICE_ACCOUNT_JSON=
# E-mail de recuperação (remetente verificado no Resend); comunicados seguem pendentes.
# Nunca usar prefixo VITE_ para conta de serviço ou chave privada.
# Supabase: URL/chave publicável podem ser expostas ao frontend; chaves secretas ficam somente no servidor.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SUPABASE_AUTH_REDIRECT_URLS=http://localhost:5173/,https://SEU-DOMINIO.vercel.app/
SUPABASE_PASSWORD_RESET_REDIRECT_URL=http://localhost:5173/
# Optional credentials used only by the local Supabase CLI stack (not the hosted project).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=
