rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function approved() {
      return request.auth != null && request.auth.token.email_verified == true &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }
    function admin() { return approved() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; }
    match /users/{uid} { allow read: if approved() && (request.auth.uid == uid || admin()); }
    match /announcements/{id} { allow read: if approved() && resource.data.archived == false && (admin() || resource.data.published == true); }
    match /{collection}/{id} {
      allow read: if approved() && collection in ['events','lists','orixas','members'] && resource.data.archived == false;
    }
    match /site/config { allow read: if approved(); }
    match /progress/{uid}/lists/{listId} { allow read: if approved() && request.auth.uid == uid; }
    // Firestore client writes and outbox reads are always denied. The API uses Admin SDK.
    match /{document=**} { allow write: if false; }
  }
}
